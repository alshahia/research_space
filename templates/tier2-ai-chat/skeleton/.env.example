# .env.example — Tier 2 ai-chat skeleton
#
# Path A (modelPath: "direct") needs ONE of the provider keys below, matching the
# `modelFamily` axis in `tier.config.json`. Default family = `google` →
# `GOOGLE_API_KEY`. Path B (modelPath: "opencode") needs NONE of these — the
# OpenCode bridge reads auth from the host's `~/.config/opencode/opencode.json`
# (or the env vars OpenCode itself consumes).
#
# Copy this file to `.env` and fill in the keys you need. Do NOT commit `.env`.

# ---------------------------------------------------------------------------
# Path A — Vercel AI SDK direct
# ---------------------------------------------------------------------------

# Google Gemini (default model family: `google`).
# Used by `@ai-sdk/google` via `createGoogleGenerativeAI({ apiKey })`.
GOOGLE_API_KEY=

# Anthropic Claude (model family: `anthropic`).
# Used by `@ai-sdk/anthropic` via `createAnthropic({ apiKey })`.
ANTHROPIC_API_KEY=

# OpenAI (model family: `openai`).
# Used by `@ai-sdk/openai` via `createOpenAI({ apiKey })`.
OPENAI_API_KEY=

# MiniMax (model family: `minimax`).
# MiniMax exposes an OpenAI-compatible endpoint; `@ai-sdk/openai` hits it via
# `baseURL`. Override `MiniMax_BASE_URL` only if MiniMax moves their endpoint.
MiniMax_API_KEY=
MiniMax_BASE_URL=https://api.minimaxi.com/v1

# ---------------------------------------------------------------------------
# Path B — OpenCode SDK bridge (modelPath: "opencode")
# ---------------------------------------------------------------------------
#
# No API keys needed. The OpenCode bridge (`src/lib/opencode.ts`) connects to
# `opencode serve` (started by `scripts/start-opencode-server.ps1`) and the
# OpenCode host already has its own provider config at
# `~/.config/opencode/opencode.json` (or `$XDG_CONFIG_HOME/opencode/opencode.json`
# on Linux).
#
# To override the opencode server URL without using the runtime file:
# OPENCODE_URL=http://127.0.0.1:<port>/
