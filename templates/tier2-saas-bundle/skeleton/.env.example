# Tier 2 SaaS bundle skeleton — environment
# Copy to .env, fill in real keys, restart `npm run dev`.
#
# In production, load these via your platform's secret manager.

# --- Stripe ---
# Server-side secret key used by `src/lib/stripe-server.ts`.
# Test mode: sk_test_xxx  |  Live mode: sk_live_xxx
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for `POST /api/webhooks/stripe`. Find it in
# https://dashboard.stripe.com/webhooks  for each endpoint you register.
# In local dev, run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and copy the `whsec_...` it prints.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Clerk ---
# Publishable key used by `<ClerkProvider>` in `src/main.tsx`.
# Visible to the browser. Test mode: pk_test_xxx  |  Live mode: pk_live_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Secret key used by `@clerk/express` middleware in `server.ts`.
# Server-only — DO NOT expose to the browser.
CLERK_SECRET_KEY=sk_test_replace_me

# --- Resend ---
# API key for transactional email (billing-failed, etc.).
# Find it at https://resend.com/api-keys.
RESEND_API_KEY=re_replace_me

# --- Server ---
# Express listens here. Dev workflow: Vite runs on VITE_PORT (5173), Express on PORT (3000);
# Vite proxies /api/* to the Express port.
PORT=3000
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
