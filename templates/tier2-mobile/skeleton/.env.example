# .env.example — Tier 2 mobile skeleton
#
# Both mobile targets (Expo + Capacitor) read the same Supabase client. The
# env-var name differs because the build tool is different:
#
#   - Expo:  EXPO_PUBLIC_*    (read by Metro at build time; embedded in the bundle)
#   - Capacitor: VITE_*       (read by Vite at build time; embedded in the bundle)
#
# Set BOTH for the active target; the unused half is ignored. Copy this file
# to `.env` and fill in the keys you need. Do NOT commit `.env`.

# ---------------------------------------------------------------------------
# Supabase client (both targets)
# ---------------------------------------------------------------------------

# Supabase project URL. Shape: https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_URL=https://example.supabase.co

# Supabase anon key (public; safe to embed). NOT the service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
VITE_SUPABASE_ANON_KEY=public-anon-key

# ---------------------------------------------------------------------------
# Clerk Expo (Expo target only — `@clerk/expo`)
# ---------------------------------------------------------------------------

# Clerk publishable key. Safe to embed.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me

# ---------------------------------------------------------------------------
# EAS Build (Expo target only)
# ---------------------------------------------------------------------------

# EAS project ID (auto-assigned after the first `eas build`).
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Capacitor (Capacitor target only)
# ---------------------------------------------------------------------------

# Override the Capacitor server URL when developing against a remote web bundle.
# Default: `dist/` (the local Vite build output).
CAPACITOR_SERVER_URL=
