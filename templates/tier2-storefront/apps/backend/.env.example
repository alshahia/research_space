# Copy this file to .env and fill in the real values. .env is gitignored.

# PostgreSQL connection string (Medusa 2 requirement). Local dev default; production
# provisions a managed Postgres (Neon, Supabase, Railway, RDS).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_storefront

# Redis URL — required for Medusa 2 event bus + worker queue. Optional in dev (Medusa
# will warn and continue with in-memory fallback). For production, use Upstash or Redis Cloud.
REDIS_URL=redis://localhost:6379

# CORS allowlists. Storefront URL on top, admin URL in dev. Comma-separated.
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:7001,http://localhost:9000,http://localhost:3000

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32
COOKIE_SECRET=replace-me-with-openssl-rand-hex-32

# Runtime
NODE_ENV=development
PORT=9000
HOST=0.0.0.0
